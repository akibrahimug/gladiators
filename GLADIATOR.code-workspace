{
  "folders": [
    {
      "name": "GLADIATOR",
      "path": "."
    }
  ],
  "settings": {
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "editor.wordWrap": "on",
    "editor.rulers": [
      100
    ],
    "explorer.sortOrder": "default",
    "markdown.preview.openMarkdownLinks": "inEditor",
    "workbench.startupEditor": "none",
    "search.exclude": {
      "**/.git": true
    },
    "files.associations": {
      "*.md": "markdown"
    }
  }
}
